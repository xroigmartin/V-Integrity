### Configuración de Entorno
@host = http://localhost:8081
@contentType = application/json

### 1. ❌ TEST: Error de Validación (RFC 7807)
# Enviamos una evidencia con campos nulos para forzar un error de validación.
# Esperamos: 400 Bad Request, Content-Type: application/problem+json, errorCode: ERR_VALIDATION
POST {{host}}/api/evidences
Content-Type: {{contentType}}

{
  "homologationId": "",
  "testRunId": "TR-TEST-001",
  "artifactName": "test.log",
  "artifactType": "LOG",
  "hashAlgorithm": null,
  "hash": "invalid-hash",
  "createdBy": "tester"
}

> {%
    client.test("Status is 400", function() {
        client.assert(response.status === 400, "Response status is not 400");
    });

    client.test("Content-Type is Problem Details", function() {
        var type = response.headers.valueOf("content-type");
        client.assert(type.includes("application/problem+json"), "Content-Type is not application/problem+json");
    });

    client.test("Check Error Code", function() {
        var body = response.body;
        client.assert(body.errorCode === "ERR_VALIDATION", "Expected errorCode ERR_VALIDATION but got " + body.errorCode);
        client.assert(body.title === "Validation Failed", "Title mismatch");
        client.assert(body.detail.includes("hashAlgorithm"), "Detail should mention hashAlgorithm");
    });
%}

### 2. ❌ TEST: Error de Negocio (Mempool Empty)
# Intentamos crear un bloque sin evidencias pendientes.
# Esperamos: 400 Bad Request, errorCode: ERR_MEMPOOL_EMPTY
POST {{host}}/api/blocks/commit
Content-Type: {{contentType}}

> {%
    client.test("Status is 400", function() {
        client.assert(response.status === 400, "Response status is not 400");
    });

    client.test("Check Error Code", function() {
        var body = response.body;
        client.assert(body.errorCode === "ERR_MEMPOOL_EMPTY", "Expected errorCode ERR_MEMPOOL_EMPTY but got " + body.errorCode);
    });
%}

### 3. ✅ TEST: Enviar Evidencia Correcta
POST {{host}}/api/evidences
Content-Type: {{contentType}}

{
  "homologationId": "HOM-2024-001",
  "testRunId": "RUN-999",
  "artifactName": "final_report.pdf",
  "artifactType": "PDF",
  "hashAlgorithm": "SHA-256",
  "hash": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
  "sizeBytes": 1024,
  "createdBy": "qa-system",
  "storageUri": "s3://bucket/reports/final.pdf",
  "standards": ["ISO-27001"]
}

> {%
    client.test("Status is 201", function() {
        client.assert(response.status === 201, "Response status is not 201");
    });
%}

### 4. ✅ TEST: Comitear Bloque (Leader)
# Ahora que hay evidencias, esto debería funcionar.
POST {{host}}/api/blocks/commit
Content-Type: {{contentType}}

> {%
    client.test("Status is 201", function() {
        client.assert(response.status === 201, "Response status is not 201");
    });
    client.test("Block Created", function() {
        client.assert(response.body.block.height > 0, "Block height should be > 0");
    });
%}

### 5. ✅ TEST: Verificar Evidencia
# Verificamos que la evidencia anterior está en la cadena.
POST {{host}}/api/verify
Content-Type: {{contentType}}

{
  "hash": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"
}

> {%
    client.test("Status is 200", function() {
        client.assert(response.status === 200, "Response status is not 200");
    });
    client.test("Verified is true", function() {
        client.assert(response.body.verified === true, "Evidence should be verified");
        client.assert(response.body.proof.signatureValid === true, "Signature should be valid");
    });
%}

